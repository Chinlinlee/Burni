{
    "name": "burni-fhir-server",
    "version": "2.8.3",
    "description": "The simple FHIR server implements with nodejs-express and mongoose.",
    "main": "index.js",
    "scripts": {
        "test": "mocha --config .mocharc.fast.js",
        "test:full": "mocha --config .mocharc.full.js",
        "generate:fhir-schemas": "node ./scripts/run-fhir-schema-generators.js",
        "search-parameter:diagnostics": "node ./scripts/record-search-parameter-diagnostics.js",
        "search-parameter:verify": "node ./scripts/verify-search-parameter-diagnostics.js",
        "test:diagnostics-gate": "mocha --no-config --require test/hook.js --timeout 300000 --exit test/searchParameter/migration/diagnostics-ci-gate.test.js",
        "test:dual-database-migration": "mocha --no-config --require test/hook.js --timeout 300000 --exit test/searchParameter/migration/dual-database-operator.test.js test/searchParameter/migration/dual-database-rollout-validation.test.js test/searchParameter/migration/dual-database-bson-policy.test.js test/searchParameter/migration/streaming-migration.test.js test/scripts/dual-database-temporal-migrate-cli.test.js",
        "test:all-resource-crud": "mocha --no-config --require test/hook.js --timeout 600000 --exit test/integration/FHIR/all-resource-crud.integration.test.js",
        "search-parameter:build-artifacts": "node ./scripts/build-search-parameter-migration-artifacts.js",
        "temporal:migrate": "node ./scripts/dual-database-temporal-migrate.js",
        "temporal:preflight": "node ./scripts/dual-database-temporal-migrate.js --preflight-only",
        "mongodb:provision": "node ./scripts/mongodb-provision.js",
        "mongodb:verify": "node ./scripts/mongodb-verify.js",
        "mongodb:audit-id": "node ./scripts/mongodb-audit-id.js",
        "search-parameter:discover-examples": "node ./models/FHIR/searchParameter/migration/fixtureMapping.js",
        "build": "node ./build/init.js",
        "release": "standard-version",
        "lint": "eslint --ignore-path .gitignore .",
        "prettier": "prettier . --write"
    },
    "standard-version": {
        "skip": {
            "tag": true,
            "commit": true
        }
    },
    "author": "Chinlinlee",
    "repository": {
        "url": "https://github.com/Chinlinlee/Burni"
    },
    "license": "Apache-2.0 License",
    "engines": {
        "node": ">=22"
    },
    "_moduleAliases": {
        "@root": "./",
        "@models": "./models",
        "@mongodb": "./models/mongodb/",
        "@FhirApiService": "./api/FhirApiService"
    },
    "dependencies": {
        "abort-controller": "^3.0.0",
        "compression": "^1.8.1",
        "connect-mongo": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "express": "5.2.1",
        "express-rate-limit": "^7.1.5",
        "express-session": "^1.19.0",
        "fhir": "^4.12.0",
        "joi": "^17.12.1",
        "js-beautify": "^1.14.11",
        "jsonpath": "^1.1.1",
        "jsonwebtoken": "^9.0.2",
        "lodash": "^4.17.21",
        "mkdirp": "^3.0.1",
        "module-alias": "^2.2.3",
        "moment": "^2.30.1",
        "moment-timezone": "^0.5.45",
        "mongoose": "^8.1.1",
        "morgan": "^1.10.0",
        "node-fetch": "^2.7.0",
        "node-schedule": "^2.1.1",
        "normalize-text": "^2.4.1",
        "object-hash": "^3.0.0",
        "passport": "^0.7.0",
        "passport-http-bearer": "^1.0.1",
        "passport-local": "^1.0.0",
        "qs": "^6.11.2",
        "rootpath": "^0.1.2",
        "uid-generator": "^2.0.0",
        "uuid": "^9.0.1",
        "winston": "^3.14.2",
        "xml-formatter": "^3.6.2"
    },
    "devDependencies": {
        "babel-eslint": "^10.1.0",
        "chai": "^4.5.0",
        "eslint-config-prettier": "^9.1.0",
        "jsdoc-to-markdown": "^8.0.1",
        "mocha": "^10.7.3",
        "mongodb-memory-server": "^11.2.0"
    }
}
