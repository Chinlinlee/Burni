s/v2/introduction#conformance-statement","content":"FHIR4-0-1-Basic-Server version 18 (2,216 tests has been passed, 100% Pass)","locale":"en"},"167":{"id":"/docs/v2/introduction-6","page_id":"/docs/v2/introduction","tags":[],"type":"text","url":"/docs/v2/introduction#conformance-statement","content":"FHIR4-0-1-Basic-Server version 14 (1,948 tests has been passed, 100% Pass)","locale":"en"},"168":{"id":"/docs/v3/getting-started/configuration","page_id":"/docs/v3/getting-started/configuration","type":"page","content":"Configuration","breadcrumbs":["Docs","v3 (Preview)","Getting Started"],"tags":[],"url":"/docs/v3/getting-started/configuration","locale":"en"},"169":{"id":"/docs/v3/getting-started/configuration-0","page_id":"/docs/v3/getting-started/configuration","tags":[],"type":"text","url":"/docs/v3/getting-started/configuration","content":"Burni v3 resource configuration, environment variables, and code generation","locale":"en"},"170":{"id":"/docs/v3/getting-started/configuration-1","page_id":"/docs/v3/getting-started/configuration","type":"heading","tags":[],"url":"/docs/v3/getting-started/configuration#configuration","content":"Configuration","locale":"en"},"171":{"id":"/docs/v3/getting-started/configuration-2","page_id":"/docs/v3/getting-started/configuration","type":"heading","tags":[],"url":"/docs/v3/getting-started/configuration#1-create-and-edit-configconfigjs","content":"1\\. Create and Edit `config/config.js`","locale":"en"},"172":{"id":"/docs/v3/getting-started/configuration-3","page_id":"/docs/v3/getting-started/configuration","type":"heading","tags":[],"url":"/docs/v3/getting-started/configuration#example-configconfigjs-structure","content":"Example `config/config.js` Structure","locale":"en"},"173":{"id":"/docs/v3/getting-started/configuration-4","page_id":"/docs/v3/getting-started/configuration","type":"heading","tags":[],"url":"/docs/v3/getting-started/configuration#2-configure-environment-variables-env","content":"2\\. Configure Environment Variabl