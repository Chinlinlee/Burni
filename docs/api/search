parameter/add-search-parameter-7","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter","content":"Some search parameters from generator will got missing or incorrect. You can fix by using methods in `models\\FHIR\\searchParameterQueryHandler.js`.","locale":"en"},"338":{"id":"/docs/v2/search-parameter/add-search-parameter-8","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter#example-bundlecomposition-and-bundlemessage","content":"FHIR R4 defines `Bundle.composition` and `Bundle.message` as reference search parameters. Burni resolves them from the SearchParameter Registry and evaluates only `entry[0].resource`:","locale":"en"},"339":{"id":"/docs/v2/search-parameter/add-search-parameter-9","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter#example-bundlecomposition-and-bundlemessage","content":"`composition` — `document` Bundles whose first entry is a `Composition`","locale":"en"},"340":{"id":"/docs/v2/search-parameter/add-search-parameter-10","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter#example-bundlecomposition-and-bundlemessage","content":"`message` — `message` Bundles whose first entry is a `MessageHeader`","locale":"en"},"341":{"id":"/docs/v2/search-parameter/add-search-parameter-11","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter#example-bundlecomposition-and-bundlemessage","content":"Burni does not fan out across all `entry` elements. Only the first embedded resource participates in these special searches.","locale":"en"},"342":{"id":"/docs/v2/search-parameter/add-search-parameter-12","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter#direct-identity-search","content":"Supported value forms include relative `ResourceType/id`, a bare id normalized to the fixed target type, and an absolute URL that matches `entry[0].fullUrl`. Versioned, contained, and logical identifier references are rejected.","locale":"en"},"343":{"id":"/docs/v2/search-parameter/add-search-parameter-13","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter#direct-identity-search","content":"Example URLs:","locale":"en"},"344":{"id":"/docs/v2/search-parameter/add-search-parameter-14","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter#chained-search","content":"After the inline hop, Burni applies the target resource SearchParameter plan from the Registry. Examples:","locale":"en"},"345":{"id":"/docs/v2/search-parameter/add-search-parameter-15","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter#chained-search","content":"`composition.patient` follows `Composition::patient` and may fan out to `Patient` and `Group`. `MessageHeader.focus` is an open reference target, so a type filter is required before chaining further:","locale":"en"},"346":{"id":"/docs/v2/search-parameter/add-search-parameter-16","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter#chained-search","content":"This request is rejected with HTTP 400 and `missing-type-filter`.","locale":"en"},"347":{"id":"/docs/v2/search-parameter/add-search-parameter-17","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter#limitations","content":"Only `entry[0].resource` is evaluated; later entries do not affect results even when they contain a matching Composition or MessageHeader.","locale":"en"},"348":{"id":"/docs/v2/search-parameter/add-search-parameter-18","page_id":"/docs/v2/search-parameter/add-search-parameter","tags":[],"type":"text","url":"/docs/v2/search-parameter/add-search-parameter#limitations","content":"Bundle type and first-entry resource type must match; invalid stored Bundles simply do not match rather than returning parameter errors.","locale":"en"},"349":{"id":"/docs/v2/search-parameter/overview","page_id":"/docs/v2/search-parameter/overview","type":"page","content":"Overview","breadcrumbs":["Docs","v2 (LTS)","Search Parameters"],"tags":[],"url":"/docs/v2/search-parameter/overview","locale":"en"},"350":{"id":"/docs/v2/search-parameter/overview-0","page_id":"/docs/v2/search-parameter/overview","type":"heading","tags":[],"url":"/docs/v2/search-parameter/overview#search-parameters-overview","content":"Search parameters overview","locale":"en"},"351":{"id":"/docs/v2/search-parameter/overview-1","page_id":"/docs/v2/search-parameter/overview","type":"heading","tags":[],"url":"/docs/v2/search-parameter/overview#search-parameter-types","content":"Search Parameter Types","locale":"en"},"352":{"id":"/docs/v2/search-parameter/overview-2","page_id":"/docs/v2/search-parameter/overview","type":"heading","tags":[],"url":"/docs/v2/search-parameter/overview#parameters-for-all-resources","content":"Parameters for all resources","locale":"en"},"353":{"id":"/docs/v2/search-parameter/overview-3","page_id":"/docs/v2/search-parameter/overview","type":"heading","tags":[],"url":"/docs/v2/search-parameter/overview#search-result-parameters","content":"Search result parameters","locale":"en"},"354":{"id":"/docs/v2/search-parameter/overview-4","page_id":"/docs/v2/search-parameter/overview","type":"heading","tags":[],"url":"/docs/v2/search-parameter/overview#derived-indexes-and-custom-searchparameters","content":"Derived indexes and custom SearchParameters","locale":"en"},"355":{"id":"/docs/v2/search-parameter/overview-5","page_id":"/docs/v2/search-parameter/overview","type":"heading","tags":[],"url":"/docs/v2/search-parameter/overview#non-temporal-derived-index-boundary","content":"Non-temporal derived index boundary","locale":"en"},"356":{"id":"/docs/v2/search-parameter/overview-6","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#search-parameters-overview","content":"The burni currently support FHIR search operations below:","locale":"en"},"357":{"id":"/docs/v2/search-parameter/overview-7","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#search-parameter-types","content":"Number","locale":"en"},"358":{"id":"/docs/v2/search-parameter/overview-8","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#search-parameter-types","content":"Date/DateTime","locale":"en"},"359":{"id":"/docs/v2/search-parameter/overview-9","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#search-parameter-types","content":"String","locale":"en"},"360":{"id":"/docs/v2/search-parameter/overview-10","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#search-parameter-types","content":"Token","locale":"en"},"361":{"id":"/docs/v2/search-parameter/overview-11","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#search-parameter-types","content":"Reference","locale":"en"},"362":{"id":"/docs/v2/search-parameter/overview-12","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#parameters-for-all-resources","content":"\\_id","locale":"en"},"363":{"id":"/docs/v2/search-parameter/overview-13","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#parameters-for-all-resources","content":"\\_lastUpdated","locale":"en"},"364":{"id":"/docs/v2/search-parameter/overview-14","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#search-result-parameters","content":"\\_count","locale":"en"},"365":{"id":"/docs/v2/search-parameter/overview-15","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#derived-indexes-and-custom-searchparameters","content":"The SearchParameter Registry owns query correctness; MongoDB derived indexes only improve query performance. They are separate lifecycle concerns.","locale":"en"},"366":{"id":"/docs/v2/search-parameter/overview-16","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#derived-indexes-and-custom-searchparameters","content":"First-phase provisioning creates derived indexes for **approved built-in temporal and non-temporal SearchParameters**. Each included lookup must be active, compilable, pass the corresponding index policy, and expose a safe index contract for its extraction/projection branch.","locale":"en"},"367":{"id":"/docs/v2/search-parameter/overview-17","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#non-temporal-derived-index-boundary","content":"**token**: system-code or system-value correlation for Coding/CodeableConcept/Identifier/ContactPoint; `:text` queries are not indexed.","locale":"en"},"368":{"id":"/docs/v2/search-parameter/overview-18","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#non-temporal-derived-index-boundary","content":"**reference**: indexes stored `reference` only; `Reference.type` target guards remain runtime filters.","locale":"en"},"369":{"id":"/docs/v2/search-parameter/overview-19","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#non-temporal-derived-index-boundary","content":"**string**: equality indexes on exact projected leaves only; default prefix and `:contains` keep regex semantics without B-tree claims.","locale":"en"},"370":{"id":"/docs/v2/search-parameter/overview-20","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#non-temporal-derived-index-boundary","content":"**number / quantity**: use existing numeric BSON fields; `sa`, `eb`, and `ap` comparators are not supported in the capability matrix.","locale":"en"},"371":{"id":"/docs/v2/search-parameter/overview-21","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#non-temporal-derived-index-boundary","content":"**uri**: raw URI single-field index shared by exact, `:above`, and `:below`.","locale":"en"},"372":{"id":"/docs/v2/search-parameter/overview-22","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#non-temporal-derived-index-boundary","content":"**array correlation**: only a single verifiable array scope is admitted; parallel multikey, positional paths, and unsafe branches produce stable rejection diagnostics.","locale":"en"},"373":{"id":"/docs/v2/search-parameter/overview-23","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#non-temporal-derived-index-boundary","content":"**Custom database SearchParameters** remain executable by default but are **not** added to the desired index manifest, so they do not receive derived indexes. That does not disable the query; it means MongoDB may use COLLSCAN. When performance indexes are missing, run `npm run mongodb:verify` to inspect drift and run `npm run mongodb:provision` as part of deployment.","locale":"en"},"374":{"id":"/docs/v2/search-parameter/overview-24","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#non-temporal-derived-index-boundary","content":"The expected derived index state is merged into the runtime-generated desired index manifest. See the MongoDB provisioning section in Deploy.","locale":"en"},"375":{"id":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler","page_id":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler","type":"page","content":"searchParameterQueryHandler","breadcrumbs":["Docs","v2 (LTS)","Code API Documentation","Models","Code API Documentation"],"tags":[],"url":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler","locale":"en"},"376":{"id":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler-0","page_id":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler","type":"heading","tags":[],"url":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler#functions","content":"Functions","locale":"en"},"377":{"id":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler-1","page_id":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler","type":"heading","tags":[],"url":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler#getstringqueryquery-paramssearchfields-queryfieldname","content":"getStringQuery(query, paramsSearchFields, queryFieldName)","locale":"en"},"378":{"id":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler-2","page_id":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler","type":"heading","tags":[],"url":"/docs/v2/code-api-documentation/models/fhir/search-parameter-query-handler#getaddressqueryquery-queryfieldname","content":"getAddressQuery(query, queryFieldName)","locale":"en"},"379":{"id":"/docs/v2/code-api-documentation/