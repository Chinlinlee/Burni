ns","locale":"en"},"108":{"id":"/docs/v3/system-search-parameters-4","page_id":"/docs/v3/system-search-parameters","type":"heading","tags":[],"url":"/docs/v3/system-search-parameters#2-_security-security-labels","content":"2\\. `_security`: Security Labels","locale":"en"},"109":{"id":"/docs/v3/system-search-parameters-5","page_id":"/docs/v3/system-search-parameters","type":"heading","tags":[],"url":"/docs/v3/system-search-parameters#3-_profile-profile-conformance","content":"3\\. `_profile`: Profile Conformance","locale":"en"},"110":{"id":"/docs/v3/system-search-parameters-6","page_id":"/docs/v3/system-search-parameters","type":"heading","tags":[],"url":"/docs/v3/system-search-parameters#4-full-date--timezone-offset-precision","content":"4\\. Full Date & Timezone Offset Precision","locale":"en"},"111":{"id":"/docs/v3/system-search-parameters-7","page_id":"/docs/v3/system-search-parameters","tags":[],"type":"text","url":"/docs/v3/system-search-parameters#fhir-system-search-parameters","content":"The HL7 FHIR standard defines system search parameters that apply across all resource types. **Burni v3** provides full native support and MongoDB query optimization for these parameters.","locale":"en"},"112":{"id":"/docs/v3/system-search-parameters-8","page_id":"/docs/v3/system-search-parameters","tags":[],"type":"text","url":"/docs/v3/system-search-parameters#1-_tag-filtering-by-meta-tags","content":"Find resources associated with specific category or metadata tags (`Resource.meta.tag`):","locale":"en"},"113":{"id":"/docs/v3/system-search-parameters-9","page_id":"/docs/v3/system-search-parameters","tags":[],"type":"text","url":"/docs/v3/system-search-parameters#multiple-tag-combinations","content":"Comma separated (`_tag=a,b`): Logical OR","locale":"en"},"114":{"id":"/docs/v3/system-search-parameters-10","page_id":"/docs/v3/system-search-parameters","tags":[],"type":"text","url":"/docs/v3/system-search-parameters#multiple-tag-combinations","content":"Repeated parameters (`