","content":"Token","locale":"en"},"293":{"id":"/docs/v2/search-parameter/overview-11","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#search-parameter-types","content":"Reference","locale":"en"},"294":{"id":"/docs/v2/search-parameter/overview-12","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#parameters-for-all-resources","content":"\\_id","locale":"en"},"295":{"id":"/docs/v2/search-parameter/overview-13","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#parameters-for-all-resources","content":"\\_lastUpdated","locale":"en"},"296":{"id":"/docs/v2/search-parameter/overview-14","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#search-result-parameters","content":"\\_count","locale":"en"},"297":{"id":"/docs/v2/search-parameter/overview-15","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#derived-indexes-and-custom-searchparameters","content":"The SearchParameter Registry owns query correctness; MongoDB derived indexes only improve query performance. They are separate lifecycle concerns.","locale":"en"},"298":{"id":"/docs/v2/search-parameter/overview-16","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-parameter/overview#derived-indexes-and-custom-searchparameters","content":"First-phase provisioning creates derived indexes for **approved built-in temporal and non-temporal SearchParameters**. Each included lookup must be active, compilable, pass the corresponding index policy, and expose a safe index contract for its extraction/projection branch.","locale":"en"},"299":{"id":"/docs/v2/search-parameter/overview-17","page_id":"/docs/v2/search-parameter/overview","tags":[],"type":"text","url":"/docs/v2/search-para